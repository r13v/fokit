{
	"name": "fokit",
	"version": "0.0.0",
	"description": "A code-first, schema-validated React form library.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./core": {
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.js"
			},
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			},
			"default": "./dist/core.js"
		},
		"./react19": {
			"import": {
				"types": "./dist/react19.d.ts",
				"default": "./dist/react19.js"
			},
			"require": {
				"types": "./dist/react19.d.cts",
				"default": "./dist/react19.cjs"
			},
			"default": "./dist/react19.js"
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			},
			"require": {
				"types": "./dist/server.d.cts",
				"default": "./dist/server.cjs"
			},
			"default": "./dist/server.js"
		},
		"./layout.css": "./dist/layout.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --project tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "npm run build && tsc --project tsconfig.json",
		"test:browser": "playwright test",
		"test:package": "npm run build && vitest run --config vitest.package.config.ts",
		"test:smoke": "node scripts/verify-smoke-fixtures.mjs",
		"test:docs": "npm run build && tsc --project tsconfig.docs.json",
		"package:check": "npm run build && publint --strict && attw --pack . --profile node16 --entrypoints . ./core ./react19 ./server",
		"knip": "knip",
		"verify": "npm run check && npm run typecheck && npm run test && npm run test:types && npm run test:browser && npm run test:package && npm run test:smoke && npm run package:check && npm run test:docs && npm run knip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r13v/fokit.git"
	},
	"bugs": {
		"url": "https://github.com/r13v/fokit/issues"
	},
	"homepage": "https://github.com/r13v/fokit#readme",
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "1.62.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"fast-check": "4.9.0",
		"jsdom": "30.0.0",
		"knip": "6.29.0",
		"lefthook": "2.1.10",
		"publint": "0.3.22",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"zod": "4.4.3"
	}
}
