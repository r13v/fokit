{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": false,
		"plugins": [{ "name": "next" }],
		"paths": {
			"fokit": [
				"../../../src/index.ts",
				"./node_modules/fokit/dist/index.d.ts"
			],
			"fokit/core": [
				"../../../src/core/index.ts",
				"./node_modules/fokit/dist/core.d.ts"
			],
			"fokit/react19": [
				"../../../src/react19/index.ts",
				"./node_modules/fokit/dist/react19.d.ts"
			],
			"fokit/server": [
				"../../../src/server/index.ts",
				"./node_modules/fokit/dist/server.d.ts"
			]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
