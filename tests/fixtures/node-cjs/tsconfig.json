{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": false,
		"types": ["node"],
		"paths": {
			"form-please": [
				"../../../dist/index.d.cts",
				"./node_modules/form-please/dist/index.d.cts"
			],
			"form-please/core": [
				"../../../dist/core.d.cts",
				"./node_modules/form-please/dist/core.d.cts"
			],
			"form-please/server": [
				"../../../dist/server.d.cts",
				"./node_modules/form-please/dist/server.d.cts"
			]
		}
	},
	"include": ["index.cts"]
}
