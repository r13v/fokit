{
	"name": "form-please",
	"version": "1.0.0",
	"description": "Build forms with ease",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./core": {
			"import": {
				"types": "./dist/core.d.ts",
				"default": "./dist/core.js"
			},
			"require": {
				"types": "./dist/core.d.cts",
				"default": "./dist/core.cjs"
			},
			"default": "./dist/core.js"
		},
		"./react19": {
			"import": {
				"types": "./dist/react19.d.ts",
				"default": "./dist/react19.js"
			},
			"require": {
				"types": "./dist/react19.d.cts",
				"default": "./dist/react19.cjs"
			},
			"default": "./dist/react19.js"
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			},
			"require": {
				"types": "./dist/server.d.cts",
				"default": "./dist/server.cjs"
			},
			"default": "./dist/server.js"
		},
		"./layout.css": "./dist/layout.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --project tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "npm run build && tsc --project tsconfig.json",
		"test:browser": "playwright test",
		"test:package": "npm run build && vitest run --config vitest.package.config.ts",
		"test:smoke": "node scripts/verify-smoke-fixtures.mjs",
		"test:docs": "npm run build && npm run typecheck --prefix docs-site",
		"site:dev": "npm run build && npm run dev --prefix docs-site",
		"site:build": "npm run build && npm run build --prefix docs-site",
		"site:test": "npm run test --prefix docs-site",
		"site:test:e2e": "playwright test --config playwright.docs.config.ts",
		"site:verify:preview": "npm run site:test && npm run test:docs && BASE_URL=http://127.0.0.1:4175 BASE_PATH=/form-please npm run site:build && npm run test:markdown --prefix docs-site && npm run test:output --prefix docs-site && npm run site:test:e2e",
		"site:verify:production": "BASE_PATH=/form-please npm run site:build && EXPECT_PRODUCTION_URL=true npm run test:output --prefix docs-site",
		"site:verify": "npm run site:verify:preview && npm run site:verify:production",
		"package:check": "npm run build && publint --strict && attw --pack . --profile node16 --entrypoints . ./core ./react19 ./server",
		"knip": "knip --workspace . --workspace docs-site",
		"verify": "npm run check && npm run test && npm run test:types && npm run test:browser && npm run test:package && npm run test:smoke && npm run package:check && npm run knip"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r13v/form-please.git"
	},
	"bugs": {
		"url": "https://github.com/r13v/form-please/issues"
	},
	"homepage": "https://r13v.github.io/form-please/",
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "1.62.0",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"fast-check": "4.9.0",
		"jsdom": "30.0.0",
		"knip": "6.29.0",
		"lefthook": "2.1.10",
		"publint": "0.3.22",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tsdown": "0.22.14",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"yaml": "2.9.0",
		"zod": "4.4.3"
	}
}
