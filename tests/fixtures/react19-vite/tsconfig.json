{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"types": ["vite/client"],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"form-please": [
				"../../../src/index.ts",
				"./node_modules/form-please/dist/index.d.ts"
			]
		}
	},
	"include": ["src"]
}
