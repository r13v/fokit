{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"types": ["vite/client"],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"react": ["./node_modules/@types/react/index.d.ts"],
			"react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
			"form-please": [
				"../../../src/index.ts",
				"./node_modules/form-please/dist/index.d.ts"
			],
			"form-please/core": [
				"../../../src/core/index.ts",
				"./node_modules/form-please/dist/core.d.ts"
			]
		}
	},
	"include": ["src"]
}
