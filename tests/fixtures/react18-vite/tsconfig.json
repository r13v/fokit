{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"types": ["vite/client"],
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"fokit": [
				"../../../src/index.ts",
				"./node_modules/fokit/dist/index.d.ts"
			],
			"fokit/core": [
				"../../../src/core/index.ts",
				"./node_modules/fokit/dist/core.d.ts"
			]
		}
	},
	"include": ["src"]
}
