{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["tests/fixtures/**"],
	"ignoreDependencies": ["@fontsource-variable/newsreader", "fokit", "zod"],
	"ignoreFiles": ["docs-site/src/content.js", "docs-site/src/lab.jsx"],
